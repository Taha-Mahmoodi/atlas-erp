# Atlas ERP environment — copy to .env and adjust. Never commit .env.
# All variables use the ATLAS_ prefix (see STRUCTURE.md §7).

# Runtime environment: dev | test | prod
ATLAS_ENV=dev

# Database. Postgres (docker-compose) or SQLite for a zero-dependency demo run.
ATLAS_DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5432/atlas
# ATLAS_DATABASE_URL=sqlite+aiosqlite:///./atlas.db

# Auth — generate a real secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
# REQUIRED in prod: the app refuses to start with the default value (or any
# secret shorter than 32 chars) when ATLAS_ENV=prod.
ATLAS_JWT_SECRET=change-me
ATLAS_JWT_ACCESS_TTL_SECONDS=900
ATLAS_JWT_REFRESH_TTL_SECONDS=1209600

# CORS origins for the frontend dev server (comma-separated)
ATLAS_CORS_ORIGINS=http://localhost:5173

ATLAS_LOG_LEVEL=INFO
